{
  "id": "eventframe-memory",
  "name": "EventFrame Memory",
  "description": "Event-centric recall and context assembly backed by eventframed and LibraVDB.",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socketPath": {
        "type": "string"
      },
      "tenantId": {
        "type": "string"
      },
      "recallK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "packK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "tokenBudget": {
        "type": "integer",
        "minimum": 1
      },
      "capture": {
        "type": "boolean"
      }
    }
  },
  "uiHints": {
    "socketPath": {
      "label": "Daemon socket",
      "placeholder": "~/.eventframed/run/eventframed.sock"
    },
    "tenantId": {
      "label": "Tenant ID"
    }
  }
}
