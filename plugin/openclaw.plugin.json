{
  "id": "eventframe-memory",
  "name": "EventFrame Memory",
  "description": "Event-centric recall and context assembly backed by eventframed and LibraVDB.",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socketPath": {
        "type": "string"
      },
      "tenantId": {
        "type": "string"
      },
      "recallK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "packK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "tokenBudget": {
        "type": "integer",
        "minimum": 1
      },
      "capture": {
        "type": "boolean"
      },
      "tracePath": {
        "type": "string"
      },
      "agencyEnabled": {
        "type": "boolean"
      },
      "agencyKillSwitch": {
        "type": "boolean"
      },
      "agencyPublicKeyPath": {
        "type": "string"
      },
      "agencyAuthorityTokenPath": {
        "type": "string"
      },
      "agencyCapabilities": {
        "type": "array",
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": ["eventframe.agency.wake", "eventframe.agency.notify", "eventframe.agency.schedule"]
        }
      },
      "agencyConsentActions": {
        "type": "array",
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": ["wake", "notify", "schedule"]
        }
      },
      "agencyConsumerId": {
        "type": "string"
      },
      "agencyPollIntervalMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      },
      "agencyMaxClaims": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "agencyMaxChainDepth": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16
      },
      "agencyQuietHoursStartUtc": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      },
      "agencyQuietHoursEndUtc": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      },
      "agencyCriticalThreshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "agencyAllowedSessionPrefixes": {
        "type": "array",
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "uiHints": {
    "socketPath": {
      "label": "Daemon socket",
      "placeholder": "~/.eventframed/run/eventframed.sock"
    },
    "tenantId": {
      "label": "Tenant ID"
    },
    "agencyKillSwitch": {
      "label": "Agency kill switch"
    },
    "agencyPublicKeyPath": {
      "label": "Agency public key"
    },
    "agencyAuthorityTokenPath": {
      "label": "Agency authority token"
    }
  }
}
