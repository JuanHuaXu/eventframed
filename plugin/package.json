{
  "name": "@eventframe/openclaw-eventframe-memory",
  "version": "0.1.0-rc.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "OpenClaw contract adapter for eventframed",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "openclaw": "2026.7.1-2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.2"
    }
  }
}
