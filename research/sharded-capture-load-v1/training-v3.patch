-// trainQuantizer trains the quantizer using collected training vectors
+// Only completed samples count toward training; reservation alone is not publication.
+func (h *Index) collectTrainingVector(ctx context.Context, vector []float32) error {
+	h.trainingMu.Lock()
+	defer h.trainingMu.Unlock()
+	if h.quantizationTrained.Load() {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	threshold := h.getTrainingThreshold()
+	if len(h.trainingVectors) < threshold || threshold <= 0 {
+		return fmt.Errorf("training buffer unavailable")
+	}
+	count := int(h.trainingCount.Load())
+	if count < threshold {
+		h.trainingVectors[count] = append([]float32(nil), vector...)
+		count++
+		h.trainingCount.Store(int32(count))
+	}
+	if count == threshold {
+		return h.trainQuantizer(ctx)
+	}
+	return nil
+}
+
